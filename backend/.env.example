# Local development example only. Use deployment secrets for the pilot.
DATABASE_URL=postgresql+psycopg://saveat:change-me@127.0.0.1:5432/saveat
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","http://localhost:8081","http://127.0.0.1:8081"]
BUSINESS_REGISTRATION_REQUIRES_APPROVAL=true
PUSH_WORKER_ENABLED=true
WEB_PUSH_ALLOWED_HOSTS=["fcm.googleapis.com","updates.push.services.mozilla.com","web.push.apple.com"]
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@saveat.kz

# Automated tests read only this variable, never the application's DATABASE_URL.
# Export only when selecting another isolated local PostgreSQL test database.
# SAVEAT_TEST_DATABASE_URL=postgresql+psycopg://saveat_test:saveat_test@127.0.0.1:54329/saveat_test
