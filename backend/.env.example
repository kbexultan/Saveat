# Copy to backend/.env and fill in. Never commit the real file.

# Application database (Supabase / PostgreSQL). Placeholder only.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional web push keys. Leave empty to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@saveat.kz

# Automated tests do NOT use DATABASE_URL. They read this variable,
# default to the Docker database below, and refuse non-local hosts.
# Set it in your shell only if you need a different local test database.
# SAVEAT_TEST_DATABASE_URL=postgresql+psycopg://saveat_test:saveat_test@127.0.0.1:54329/saveat_test
