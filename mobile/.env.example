# Базовый URL SAVEAT API.
#
# Симулятор iOS / веб на том же компьютере:
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8001
#
# Эмулятор Android (AVD) обращается к хосту через 10.0.2.2:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8001
#
# Реальный телефон в той же Wi-Fi сети — адрес компьютера в сети,
# 127.0.0.1 для телефона указывает на сам телефон и работать не будет:
#   EXPO_PUBLIC_API_URL=http://<ip-вашего-компьютера>:8001
EXPO_PUBLIC_API_URL=http://127.0.0.1:8001

# Только для Android-сборок карты (expo run:android / EAS build).
# В Expo Go и на iOS не требуется. Пустое значение допустимо.
GOOGLE_MAPS_API_KEY=
